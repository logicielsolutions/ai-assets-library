# Copy to .env and fill in. Never commit .env.

# Voiceover (https://elevenlabs.io > Profile > API keys). Text to speech permission is enough.
# Commercial use needs a paid ElevenLabs plan.
ELEVENLABS_API_KEY=
# Optional: default voice id (Matilda) and model
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL=eleven_v3

# Optional: only for Google narration voices inside google-flow-mcp (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
